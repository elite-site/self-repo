# Base URL of the backend API. Include the /api suffix; the client appends it if missing.
VITE_API_BASE_URL=http://localhost:5001/api

# Set to "true" to serve LearningHub course/lesson data from local fixtures instead of the API.
VITE_LEARNING_MOCK=false

# Set to "false" to hide the LearningHub navigation and routes entirely.
VITE_FEATURE_LEARNINGHUB=true
