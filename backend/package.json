{
  "name": "self-intro-portal-backend",
  "version": "1.0.0",
  "description": "Self Introduction Portal — Submission & Admin API",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node src/server.ts",
    "build": "tsc",
    "install:admin": "npm install --include=dev --prefix ../admin-client",
    "build:admin": "npm run install:admin && npm run --prefix ../admin-client build",
    "build:all": "npm run build:admin && npm run build",
    "postinstall": "npm run install:admin",
    "start": "node dist/server.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:push": "prisma db push",
    "prisma:seed": "ts-node prisma/seed.ts",
    "roster:import": "ts-node scripts/import-roster.ts",
    "test": "vitest run",
    "db:setup": "ts-node scripts/db-setup.ts",
    "get-token": "ts-node scripts/get-oauth-token.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/form-data": "^2.2.1",
    "@types/jsonwebtoken": "^9.0.8",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.1",
    "bcryptjs": "^2.4.3",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "file-type": "^16.5.4",
    "form-data": "^4.0.6",
    "googleapis": "^144.0.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^4.6.0",
    "prisma": "^5.22.0",
    "resend": "^4.1.1",
    "sharp": "^0.33.5",
    "ts-node": "^10.9.2",
    "typescript": "5.9.3"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.2.2",
    "vitest": "^5.0.1"
  },
  "allowScripts": {
    "@prisma/client@5.22.0": true,
    "@prisma/engines@5.22.0": true,
    "prisma@5.22.0": true,
    "sharp@0.33.5": true,
    "bcryptjs@2.4.3": true
  }
}
