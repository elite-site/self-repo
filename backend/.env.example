PORT=5001
NODE_ENV=development
# Use port 6543 (transaction pooler) for production API runtime with high concurrency.
# Port 5432 (session pooler) works for lower concurrency or local development.
DATABASE_URL=postgresql://postgres.YOUR_REF:<PASSWORD>@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?schema=public
# Direct (non-pooler) connection used by Prisma migrations and CLI commands.
DIRECT_URL=postgresql://postgres.YOUR_REF:<PASSWORD>@aws-0-ap-south-1.supabase.co:5432/postgres?schema=public
JWT_SECRET=change-me
ADMIN_SESSION_COOKIE_NAME=si_admin_session
STUDENT_JWT_SECRET=change-me-student

# Google Drive OAuth 2.0 (primary) — set REFRESH_TOKEN after running `npm run get-token`
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
GOOGLE_DRIVE_ROOT_FOLDER_ID=

# Google Drive Service Account (fallback — leave empty when OAuth is configured)
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=

# Resend Email Configuration
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=Self Introduction <elite@sasi.ac.in>

# File Upload Limits
MAX_IMAGE_SIZE_MB=15
# Default ceiling for introduction videos, used when an administrator has not
# set one in the portal's Settings. A Settings value overrides this.
MAX_VIDEO_SIZE_MB=25
# Absolute ceiling on a buffered upload body, regardless of the setting above.
MAX_VIDEO_SIZE_HARD_CAP_MB=100

# Background maintenance, both opt-in because both write to the database or to
# Google Drive on every boot.
AUTO_MIGRATE_PENDING=false
SYNC_DRIVE_PERMISSIONS=false

# CORS Allowed Origin (public form URL in production, localhost in development)
ALLOWED_ORIGIN=http://localhost:5173

# Admin default seed
ADMIN_DEFAULT_USERNAME=ADMIN
ADMIN_DEFAULT_PASSWORD=ADMIN123

# Event configuration
EVENT_YEAR=2026

# --- Google Workspace SSO (student login) ---
GOOGLE_SSO_CLIENT_ID=
GOOGLE_SSO_CLIENT_SECRET=
GOOGLE_SSO_REDIRECT_URI=http://localhost:5001/api/student/google/callback
GOOGLE_SSO_HD=sasi.ac.in
STUDENT_APP_LOGIN_URL=http://localhost:5173/login
