# ==============================================================================
# Self Introduction Portal — Backend Environment Configuration (.env.example)
# ==============================================================================
# All variables validated at startup in backend/src/config/env.ts.
# Copy this file to .env and replace placeholders with real secrets.

# --- Server & Runtime ---
# Port number Express server listens on (default: 5001)
PORT=5001

# Runtime environment ('development' | 'production' | 'test')
NODE_ENV=development

# --- Database (PostgreSQL / Supabase) ---
# Runtime connection string. Use port 6543 (transaction pooler) for production API.
DATABASE_URL=postgresql://postgres.YOUR_REF:<PASSWORD>@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?schema=public

# Direct (non-pooler) connection used by Prisma migrations and CLI scripts.
DIRECT_URL=postgresql://postgres.YOUR_REF:<PASSWORD>@aws-0-ap-south-1.supabase.co:5432/postgres?schema=public

# Optional explicit connection pool limit for Prisma client (default: 5)
DB_CONNECTION_LIMIT=5

# Threshold in milliseconds to log slow Prisma queries (default: 500)
SLOW_QUERY_THRESHOLD_MS=500

# --- Authentication & Session Secrets ---
# Secret key used for signing admin JWT sessions (MUST be rotated and strong in production)
JWT_SECRET=change-me-dev-admin-jwt-secret-do-not-use-in-prod

# Name of the HTTP-only admin cookie
ADMIN_SESSION_COOKIE_NAME=si_admin_session

# Secret key used for signing student JWT session tokens (defaults to JWT_SECRET if unset)
STUDENT_JWT_SECRET=change-me-dev-student-jwt-secret-do-not-use-in-prod

# Emergency escape hatch: allow starting in production with default secrets (NOT RECOMMENDED)
ALLOW_INSECURE_DEFAULT_SECRETS=false

# --- Storage: Google Drive OAuth 2.0 (Primary) ---
# Google Cloud OAuth 2.0 Client credentials with Drive full access scope
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Refresh token obtained by running `npm run get-token`
GOOGLE_OAUTH_REFRESH_TOKEN=
# Root Google Drive folder ID under which student assets will be organized
GOOGLE_DRIVE_ROOT_FOLDER_ID=

# --- Storage: Google Drive Service Account (Legacy / Fallback) ---
# Service account email and RSA private key (leave empty when OAuth 2.0 is configured)
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=

# --- Email Notifications (Resend) ---
# Resend API key for transactional emails
RESEND_API_KEY=
# From address header for outbound emails
EMAIL_FROM_ADDRESS=Self Introduction <elite@sasi.ac.in>

# --- File Upload Limits ---
# Maximum profile photo / image size in MB (default: 10)
MAX_IMAGE_SIZE_MB=10

# Maximum audio upload size in MB (default: 10)
MAX_AUDIO_SIZE_MB=10

# Default ceiling for introduction videos in MB (default: 25).
# An admin setting in database can override this default.
MAX_VIDEO_SIZE_MB=25

# Hard buffer ceiling for uploaded video payloads in MB (default: 100)
MAX_VIDEO_SIZE_HARD_CAP_MB=100

# --- Background Maintenance ---
# Run pending backlog migrations on server startup (true | false)
AUTO_MIGRATE_PENDING=false

# Reconcile Google Drive public permissions on server startup (true | false)
SYNC_DRIVE_PERMISSIONS=false

# --- CORS & Client Origin ---
# Single allowed origin (development fallback)
ALLOWED_ORIGIN=http://localhost:5173

# Comma-separated list of allowed origins in production (e.g. https://student.sasi.ac.in,https://admin.sasi.ac.in)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# --- Seed Defaults ---
# Default initial admin email and password created by prisma/seed.ts
ADMIN_DEFAULT_EMAIL=admin@club.internal
ADMIN_DEFAULT_USERNAME=ADMIN
ADMIN_DEFAULT_PASSWORD=AdminPassword123!

# --- Event Configuration ---
# Active event identifier targeted by student portal submissions
ACTIVE_EVENT_ID=self-introduction-2026

# Academic event year
EVENT_YEAR=2026

# --- Google Workspace SSO (Student Login) ---
# Client ID and secret for student Google Workspace OAuth login
GOOGLE_SSO_CLIENT_ID=
GOOGLE_SSO_CLIENT_SECRET=
# Backend callback URL registered in Google Cloud Console
GOOGLE_SSO_REDIRECT_URI=http://localhost:5001/api/student/google/callback
# Hosted domain restriction ensuring only institution emails authenticate (e.g. sasi.ac.in)
GOOGLE_SSO_HD=sasi.ac.in
# Frontend login page where student is redirected with session token
STUDENT_APP_LOGIN_URL=http://localhost:5173/login

# --- GitHub Portfolio Integration ---
# GitHub OAuth application credentials
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_REDIRECT_URI=http://localhost:5001/api/student/github/callback
# Personal access token with public repo read permissions used for rate-reserve requests
GITHUB_API_TOKEN=
GITHUB_API_VERSION=2022-11-28
# Minimum remaining GitHub API rate limit before backing off (default: 500)
GITHUB_RATE_RESERVE=500
# Cooldown between background repo syncs per student in minutes (default: 15)
GITHUB_SYNC_COOLDOWN_MIN=15
# Daily sync limit cap per student (default: 5)
GITHUB_SYNC_DAILY_CAP=5
# Feature flag to enable or disable GitHub integration in student portal
FEATURE_GITHUB_PORTFOLIO=false
# Secret key for internal sync job triggering
INTERNAL_SYNC_SECRET=
