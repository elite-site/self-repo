DATABASE_URL="postgresql://postgres:postgres@localhost:5432/self_intro_portal?schema=public"
PORT=5001
NODE_ENV="development"
JWT_SECRET="self_intro_portal_jwt_key_development_only_change_in_prod"
ADMIN_SESSION_COOKIE_NAME="si_admin_session"
STUDENT_JWT_SECRET="student_portal_jwt_key_development_only_change_in_prod"

# Google Drive Service Account (set to enable real Drive upload, otherwise local mock mode stores files in storage/mock-drive)
GOOGLE_SERVICE_ACCOUNT_EMAIL=""
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=""
GOOGLE_DRIVE_ROOT_FOLDER_ID=""

# Resend Email Configuration (set to enable real email dispatch, otherwise mock mode logs sends)
RESEND_API_KEY=""
EMAIL_FROM_ADDRESS="Self Introduction <elite@sasi.ac.in>"

# File Upload Limits
MAX_IMAGE_SIZE_MB=15
MAX_VIDEO_SIZE_MB=80

# CORS Allowed Origin (web URL in production, localhost in development)
ALLOWED_ORIGIN="http://localhost:5177"

# Admin default seed
ADMIN_DEFAULT_USERNAME="ADMIN"
ADMIN_DEFAULT_PASSWORD="ADMIN123"

# Event configuration
EVENT_YEAR=2026