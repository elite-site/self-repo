PORT=5000
NODE_ENV=development
DATABASE_URL=postgresql://postgres.YOUR_REF:<PASSWORD>@aws-0-ap-south-1.pooler.supabase.com:5432/postgres
JWT_SECRET=change-me
ADMIN_SESSION_COOKIE_NAME=si_admin_session
STUDENT_JWT_SECRET=change-me-student

# Google Drive OAuth 2.0 (primary) — set REFRESH_TOKEN after running `npm run get-token`
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
GOOGLE_DRIVE_ROOT_FOLDER_ID=

# Google Drive Service Account (fallback — leave empty when OAuth is configured)
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=

# Resend Email Configuration
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=Self Introduction <elite@sasi.ac.in>

# File Upload Limits
MAX_IMAGE_SIZE_MB=15
MAX_VIDEO_SIZE_MB=25

# CORS Allowed Origin (public form URL in production, localhost in development)
ALLOWED_ORIGIN=http://localhost:5173

# Admin default seed
ADMIN_DEFAULT_USERNAME=ADMIN
ADMIN_DEFAULT_PASSWORD=ADMIN123

# Event configuration
EVENT_YEAR=2026

# --- Google Workspace SSO (student login) ---
GOOGLE_SSO_CLIENT_ID=
GOOGLE_SSO_CLIENT_SECRET=
GOOGLE_SSO_REDIRECT_URI=http://localhost:5001/api/student/google/callback
GOOGLE_SSO_HD=sasi.ac.in
STUDENT_APP_LOGIN_URL=http://localhost:5173/login
